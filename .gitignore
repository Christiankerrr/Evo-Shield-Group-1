!HyperNEAT/NE/HyperNEAT/out/data/
!HyperNEAT/NE/HyperNEAT/out/OpenCL/

# Trainer runs (web UI uploads/jobs, ad-hoc runs)
HyperNEAT/NE/HyperNEAT/run/uploads/
HyperNEAT/NE/HyperNEAT/run/jobs/
HyperNEAT/NE/HyperNEAT/run/*.xml
HyperNEAT/NE/HyperNEAT/run/*.log
